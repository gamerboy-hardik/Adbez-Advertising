// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  CLIENT
  ADMIN
}

enum AccountStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FLAGGED
  REFUNDED
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(CLIENT)
  walletBalance Float     @default(0) @map("wallet_balance")
  provider      String?   @default("Email")
  lastLogin     DateTime? @map("last_login")
  ipAddress     String?   @map("ip_address")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  transactions  Transaction[]
  footprintLogs FootprintLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model AdAccount {
  id              String        @id @default(uuid())
  platform        String // e.g. "META", "GOOGLE", "TIKTOK", "BING"
  category        String // e.g. "ad-accounts", "profiles", "bm-standard", "bm-verified", "pages"
  profileName     String        @map("profile_name")
  country         String? // e.g. "US", "VN", "HK"
  countryFlag     String?       @map("country_flag") // emoji flag
  spendingLimit   Float?        @map("spending_limit") // USD
  ageMonths       Int?          @map("age_months")
  price           Float
  status          AccountStatus @default(AVAILABLE)
  credentialsJson String?       @map("credentials_json") // AES-256-GCM encrypted JSON
  proxyDetails    String?       @map("proxy_details") // AES-256-GCM encrypted
  cookieFile      String?       @map("cookie_file") // AES-256-GCM encrypted
  recoveryFile    String?       @map("recovery_file") // AES-256-GCM encrypted
  features        Json          @default("[]") // e.g. ["Credit Line", "Uncapped", "Verified"]
  description     String?
  isFeatured      Boolean       @default(false) @map("is_featured")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  transactionItems TransactionItem[]

  @@map("ad_accounts")
}

model Transaction {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  totalAmount   Float         @map("total_amount")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod String?       @map("payment_method") // e.g. "WALLET", "NOWPAYMENTS"
  paymentRef    String?       @map("payment_ref") // external payment reference
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user  User              @relation(fields: [userId], references: [id])
  items TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String @id @default(uuid())
  transactionId String @map("transaction_id")
  adAccountId   String @map("ad_account_id")
  price         Float

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  adAccount   AdAccount   @relation(fields: [adAccountId], references: [id])

  @@map("transaction_items")
}

model FootprintLog {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  sessionId       String   @map("session_id")
  ipAddress       String?  @map("ip_address")
  ipv6Address     String?  @map("ipv6_address")
  isp             String?
  country         String?
  city            String?
  vpnDetected     Boolean  @default(false) @map("vpn_detected")
  userAgent       String?  @map("user_agent")
  screenRes       String?  @map("screen_res")
  osDetails       String?  @map("os_details")
  browserLang     String?  @map("browser_lang")
  canvasHash      String?  @map("canvas_hash")
  timezone        String?
  actionPerformed String   @map("action_performed")
  pathTraversed   String?  @map("path_traversed")
  authState       String?  @map("auth_state") // GUEST | AUTHENTICATED
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("footprint_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
